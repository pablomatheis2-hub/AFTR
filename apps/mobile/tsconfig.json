{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@aftr/shared/*": ["../../packages/shared/*"],
      "@aftr/supabase": ["../../packages/supabase"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/shared/**/*.ts",
    "../../packages/supabase/**/*.ts"
  ]
}
