{
  "name": "aftr-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "dev:mobile": "turbo dev --filter=@aftr/mobile",
    "dev:web": "turbo dev --filter=@aftr/web",
    "dev:admin": "turbo dev --filter=@aftr/admin",
    "build:web": "turbo build --filter=@aftr/web",
    "build:admin": "turbo build --filter=@aftr/admin"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@8.15.9"
}
